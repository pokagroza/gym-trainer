@page
@model RecommendationsModel
@{
    ViewData["Title"] = "Рекомендации";
}
<div class="text-center mb-4">
    <h2 class="mb-3"><span class="bi bi-lightbulb me-2"></span>Рекомендации по упражнениям</h2>
</div>
@if (Model.Exercises == null)
{
    <div class="alert alert-warning">Вы не авторизованы. <a href="/Login">Войти</a></div>
}
else if (Model.Exercises.Any())
{
    <div class="card shadow-sm p-4 mb-4 mx-auto custom-card" style="max-width: 600px;">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-sm align-middle">
                <thead class="table-success">
                    <tr>
                        <th><span class="bi bi-bar-chart"></span> Упражнение</th>
                        <th><span class="bi bi-person-arms-up"></span> Группа мышц</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var ex in Model.Exercises)
                {
                    <tr>
                        <td>@ex.Name</td>
                        <td>@ex.MuscleGroup</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">Нет рекомендаций.</div>
}
