@page
@model WorkoutsModel
@{
    ViewData["Title"] = "Готовые тренировки";
}
<div class="text-center mb-4 hero">
    <h2 class="mb-1"><span class="bi bi-dumbbell me-2"></span>Готовые тренировки</h2>
    <p class="lead muted">Найдите тренировку по уровню сложности и цели — просматривать можно без входа, чтобы выбрать нужно войти.</p>
</div>

<div class="mb-3 mx-auto" style="max-width:900px;">
    <form method="get" class="d-flex gap-2" aria-label="Фильтр по сложности">
        @{ var sel = (Request.Query["difficulty"].FirstOrDefault() ?? "all").ToString(); }
        <select name="difficulty" class="form-select difficulty-select" aria-label="Выбор сложности">
            <option value="all" selected="@(sel=="all")">Все уровни</option>
            <option value="easy" selected="@(sel=="easy")">Лёгкие</option>
            <option value="medium" selected="@(sel=="medium")">Средние</option>
            <option value="hard" selected="@(sel=="hard")">Интенсивные</option>
        </select>
        <button class="btn btn-outline-primary" aria-label="Применить фильтр">Фильтровать</button>
    </form>
</div>

@if (Model.Splits == null || !Model.Splits.Any())
{
    <div class="alert alert-info">Пока нет доступных тренировок.</div>
}
else
{
    <div class="grid-cards mb-4">
        @foreach(var split in Model.Splits)
        {
            @await Html.PartialAsync("~/Pages/Shared/_SplitCard.cshtml", new Web.Models.SplitCardModel {
                Split = split,
                ShowExercises = false,
                ActionType = Web.Models.SplitCardActionType.MarkInHistory,
                IsAuthenticated = HttpContext.Session.GetInt32("UserId") != null,
                PostUrl = "/Workouts"
            })
        }
    </div>
}
