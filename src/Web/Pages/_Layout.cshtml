@using Microsoft.AspNetCore.Mvc.RazorPages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gym Trainer</title>
    <!-- Prefer CDN for availability, but fallback to local files if offline or blocked -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" integrity="" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css?v=@DateTime.UtcNow.Ticks" />
    <!-- Emergency inline styles to ensure UI is usable even if external CSS fails to load -->
    <!-- LAYOUT INJECTION ACTIVE -->
    <style>
        /* Emergency styles (minimal) */
        body { background: #f1f5f9 !important; color: #212529 !important; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; }
        .custom-card { border-radius: 10px; background: #ffffff !important; box-shadow: 0 2px 6px rgba(0,0,0,0.04) !important; padding: 1rem; }
        .navbar { box-shadow: 0 1px 2px rgba(0,0,0,0.06); }
        .difficulty-badge { display:inline-block; padding:4px 8px; border-radius:8px; font-size:12px; color:#fff; }
        .badge-easy { background:#4caf50; }
        .badge-medium { background:#f59e0b; color:#091217; }
        .badge-hard { background:#ef4444; }
        .range-control { display:flex; align-items:center; gap:12px; }
        .range-control input[type="range"] { width:100%; }
        .form-select, .btn { min-height:38px; }
        /* quick responsive container
         (ensures main content isn't full-width if Bootstrap missing) */
        .container.py-4 { padding-left:1rem; padding-right:1rem; }
        /* Active nav state */
        .nav-link.active { position:relative; font-weight:600; color:#0d6efd !important; }
        .nav-link.active::after { content:""; position:absolute; left:8px; right:8px; bottom:4px; height:3px; background: linear-gradient(90deg,#0d6efd,#6f42c1); border-radius:2px; }
        /* Page fade transition */
        .page-transition { opacity:0; transform:translateY(6px); transition: opacity .35s ease, transform .35s ease; }
        .page-transition.ready { opacity:1; transform:translateY(0); }
        /* Smooth hover for nav */
        .navbar .nav-link { transition: color .2s ease; }
        .navbar .nav-link:hover { color:#0b5ed7; }
        html[data-theme='dark'] body { background:#101418 !important; color:#e2e8f0 !important; }
        html[data-theme='dark'] .custom-card { background:#1c2430 !important; box-shadow:0 2px 6px rgba(0,0,0,.6) !important; }
        html[data-theme='dark'] .navbar { background:#18202a !important; }
        html[data-theme='dark'] .nav-link.active { color:#66b2ff !important; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Gym Trainer</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/">Главная</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Recommendations">Рекомендации</a></li>
                    <li class="nav-item"><a class="nav-link" href="/History">История</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Workouts">Готовые тренировки</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Optimize">Оптимизация</a></li>
                </ul>
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <li class="nav-item"><a class="nav-link" href="/Profile">Профиль</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Logout">Выход</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="/Register">Регистрация</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Login">Вход</a></li>
                    }
                    <li class="nav-item d-flex align-items-center ms-3">
                        <button id="theme-toggle" class="btn btn-sm btn-outline-secondary" aria-label="Toggle theme">Тема</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container py-4">
        <div id="page-wrapper" class="page-transition">
            @RenderBody()
        </div>
    </div>
    <!-- Bootstrap bundle: try CDN first, fallback to local bundle if needed -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="" crossorigin="anonymous"></script>
    <script>if(typeof bootstrap === 'undefined'){document.write('\x3Cscript src="' + window.location.origin + '/lib/bootstrap/bootstrap.bundle.min.js">\x3C/script>');}</script>
    <script>
        // Emergency interactivity: initialize fatigue range value display and auto-submit difficulty selects
        (function(){
            try {
                // Range display updater
                document.querySelectorAll('input[type="range"]').forEach(function(r){
                    var out = document.getElementById('fatigue-value');
                    if(out){ out.textContent = r.value; }
                    r.addEventListener('input', function(e){ if(out) out.textContent = e.target.value; });
                });

                // Auto-submit GET forms when difficulty select changes
                document.querySelectorAll('select[name="difficulty"]').forEach(function(s){
                    s.addEventListener('change', function(){
                        var form = s.closest('form'); if(form && form.method.toLowerCase()==='get') form.submit();
                    });
                });
            } catch(e){ /* swallow errors */ }
        })();
        // Theme toggle: persist choice in localStorage and set data-theme attribute
        (function(){
            try {
                var btn = document.getElementById('theme-toggle');
                var root = document.documentElement;
                function applyTheme(t){
                    if(t === 'dark') root.setAttribute('data-theme','dark'); else root.removeAttribute('data-theme');
                    localStorage.setItem('gt-theme', t);
                }
                // initialize
                var saved = localStorage.getItem('gt-theme') || 'light';
                applyTheme(saved);
                if(btn){
                    btn.addEventListener('click', function(){
                        var cur = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
                        var nxt = cur === 'dark' ? 'light' : 'dark';
                        applyTheme(nxt);
                        btn.textContent = nxt === 'dark' ? 'Светлая' : 'Тёмная';
                    });
                    // initial label
                    btn.textContent = root.getAttribute('data-theme') === 'dark' ? 'Светлая' : 'Тёмная';
                }
            } catch(e) { /* ignore */ }
        })();

        // Active nav highlight + page fade-in after first paint
        (function(){
            try {
                var path = window.location.pathname.toLowerCase();
                document.querySelectorAll('.navbar .nav-link').forEach(function(a){
                    var href = a.getAttribute('href');
                    if(!href) return;
                    // Normalize (treat '/' and '/Index')
                    var normalized = href.toLowerCase();
                    if (normalized === '/' && (path === '/' || path === '/index')) {
                        a.classList.add('active');
                    } else if (normalized !== '/' && path.startsWith(normalized)) {
                        a.classList.add('active');
                    }
                });
                var wrapper = document.getElementById('page-wrapper');
                requestAnimationFrame(function(){
                    if(wrapper) wrapper.classList.add('ready');
                });
            } catch(e) { /* ignore */ }
        })();
    </script>
</body>
</html>
