@page
@model HistoryModel
@{
    ViewData["Title"] = "История тренировок";
}
<div class="text-center mb-4">
    <h2 class="mb-3"><span class="bi bi-clock-history me-2"></span>История тренировок</h2>
</div>
@if (Model.History == null)
{
    <div class="alert alert-warning">Вы не авторизованы. <a href="/Login">Войти</a></div>
}
else if (Model.History.Any())
{
    <div class="card shadow-sm p-4 mb-4 mx-auto custom-card" style="max-width: 700px;">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-sm align-middle">
                <thead class="table-primary">
                    <tr>
                        <th><span class="bi bi-calendar-event"></span> Дата</th>
                        <th><span class="bi bi-list-task"></span> Сплит</th>
                        <th><span class="bi bi-pencil"></span> Заметки</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var h in Model.History)
                {
                    <tr>
                        <td>@h.Date.ToShortDateString()</td>
                        <td>@h.TrainingSplit?.Name</td>
                        <td>@h.Notes</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">Нет истории тренировок.</div>
}
