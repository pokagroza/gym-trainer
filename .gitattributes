# Normalize line endings to LF in repo, checkout native for text
* text=auto

# Explicitly declare C# and Razor as text
*.cs text diff=csharp eol=lf
*.cshtml text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf

# Solution and project files
*.sln text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.ico binary

# Prevent diff for lock/databases
*.db binary -text

# GitHub linguist overrides (optional)
*.cs linguist-language=C#
